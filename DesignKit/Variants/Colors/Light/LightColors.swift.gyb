import Foundation
import UIKit
import SwiftUI


/// Light theme colors.
public class LightColors {
    private static let values = ColorValues(
        accent: UIColor(rgb:0x${config.colors.light.accent_color}),
        alert: UIColor(rgb:0x${config.colors.light.alert_color}),
        primaryContent: UIColor(rgb:0x${config.colors.light.text_primary_color}),
        secondaryContent: UIColor(rgb:0x${config.colors.light.text_secondary_color}),
        tertiaryContent: UIColor(rgb:0x${config.colors.light.secondary_color}),
        quarterlyContent: UIColor(rgb:0x${config.colors.light.secondary_color}),
        quinaryContent: UIColor(rgb:0x${config.colors.light.secondary_color}),
        separator: UIColor(rgb:0x${config.colors.light.background_secondary_color}),
        system: UIColor(rgb:0x${config.colors.light.background_secondary_color}),
        tile: UIColor(rgb:0x${config.colors.light.background_secondary_color}),
        navigation: UIColor(rgb:0x${config.colors.light.background_secondary_color}),
        background: UIColor(rgb:0x${config.colors.light.background_primary_color}),
        ems: UIColor(rgb: 0x7E69FF),
        links: UIColor(rgb: 0x0086E6),
        namesAndAvatars: [
% for user_name_color in config.colors.avatar_colors:
            UIColor(rgb: 0x${user_name_color}),
% end
        ]
    )
    
    public static var uiKit = ColorsUIKit(values: values)
    public static var swiftUI = ColorSwiftUI(values: values)
}





