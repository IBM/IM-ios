// App identity
BUNDLE_DISPLAY_NAME = ${config.settings.display_name}
BASE_BUNDLE_IDENTIFIER = ${config.settings.mobile.ios.bundle_identifier}
APPLICATION_GROUP_IDENTIFIER = ${config.settings.mobile.ios.application_group_identifier}
APPLICATION_SCHEME = element

// Team
DEVELOPMENT_TEAM = ${config.settings.mobile.ios.development_team}


// Provisioning profiles
RIOT_PROVISIONING_PROFILE_SPECIFIER = ${config.settings.mobile.ios.provisioning_profile_specifier}
RIOT_PROVISIONING_PROFILE = ${config.settings.mobile.ios.provisioning_profile}

NSE_PROVISIONING_PROFILE_SPECIFIER = ${config.settings.mobile.ios.nse_provisioning_profile_specifier}
NSE_PROVISIONING_PROFILE = ${config.settings.mobile.ios.nse_provisioning_profile}

SHARE_EXTENSION_PROVISIONING_PROFILE_SPECIFIER = ${config.settings.mobile.ios.share_extension_provisioning_profile_specifier}
SHARE_EXTENSION_PROVISIONING_PROFILE = ${config.settings.mobile.ios.share_extension_provisioning_profile}

SIRI_INTENTS_PROVISIONING_PROFILE_SPECIFIER = ${config.settings.mobile.ios.siri_intents_provisioning_profile_specifier}
SIRI_INTENTS_PROVISIONING_PROFILE = ${config.settings.mobile.ios.siri_intents_provisioning_profile}

% if config.capabilities.enable_voice_broadcasts:
BROADCAST_UPLOAD_EXTENSION_PROVISIONING_PROFILE_SPECIFIER = ${config.settings.mobile.ios.broadcast_upload_extension_provisioning_profile_specifier}
BROADCAST_UPLOAD_EXTENSION_PROVISIONING_PROFILE = ${config.settings.mobile.ios.broadcast_upload_extension_provisioning_profile}
% end